# -----------------------------------------------------------------------------
# Copia este archivo como `.env` (local) y pega los mismos valores en el panel
# de Vercel o Netlify (Settings -> Environment Variables).
#
# Los dos valores salen de: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# URL del proyecto. Ejemplo: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave pública del proyecto ("anon public" o "publishable key", según la edad
# del proyecto). Empieza por `eyJ...` o por `sb_publishable_...`.
#
# ES SEGURO que esta clave viaje al navegador: es pública por diseño y las
# políticas de Row Level Security del esquema son las que protegen los datos.
VITE_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# NO pongas aquí la contraseña del panel de moderación.
#
# Cualquier variable `VITE_*` queda escrita en texto plano dentro del JavaScript
# que se descarga el navegador: se lee con "Ver código fuente". La contraseña de
# moderación es la del usuario que creaste en Supabase Authentication y nunca
# sale del servidor. Ver README, paso 5.
#
# La clave `service_role` de Supabase TAMPOCO va aquí ni en ningún archivo del
# frontend, bajo ninguna circunstancia.
# -----------------------------------------------------------------------------
